APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=pass

# WHMCS import (restore dump, then clients/contacts, domains, hosting with products)
# php artisan billing:import-whmcs-clients --with-contacts
# php artisan billing:import-whmcs-domains --active-only
# php artisan billing:import-whmcs-hosting --sync-products
# php artisan billing:import-whmcs-orders
# php artisan billing:import-whmcs-orders --statuses=Paid,Unpaid
WHMCS_DB_CONNECTION=whmcs
WHMCS_DB_HOST=127.0.0.1
WHMCS_DB_PORT=3306
WHMCS_DB_DATABASE=whmcs
WHMCS_DB_USERNAME=root
WHMCS_DB_PASSWORD=
WHMCS_IMPORT_DEFAULT_CURRENCY=EUR
# Fallback product when packageid is unmapped (see config/whmcs-product-map.php).
# WHMCS_IMPORT_DEFAULT_PRODUCT_ID=1
# Fallback registrar for unknown WHMCS codes; new TLDs are created here (required for domain import).
# WHMCS_IMPORT_DEFAULT_REGISTRAR_ID=1

DOCKER_NAME=hosting
UID=1000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Billing tax defaults (percent) — seeded into billing_tax_settings; edit in Setup → Tax settings
BILLING_DEFAULT_VAT_RATE_PERCENT=23
BILLING_DEFAULT_IRS_RATE_PERCENT=11.5
BILLING_DOMAINS_IRS_EXCEPTION=false

# Billing company details (optional seed defaults — edit in Setup → Company details)
# BILLING_COMPANY_NAME=
# BILLING_COMPANY_ADDRESS=
# BILLING_COMPANY_POSTAL_CODE=
# BILLING_COMPANY_CITY=
# BILLING_COMPANY_COUNTRY=PT
# BILLING_COMPANY_PHONE=
# BILLING_COMPANY_EMAIL=
# BILLING_COMPANY_BANK_ACCOUNT=

# Billing automation (daily renewal orders + reminders — configure time in app)
BILLING_AUTOMATION_ENABLED=true
BILLING_AUTOMATION_RUN_AT=09:00
BILLING_AUTOMATION_SERVICE_DAYS_BEFORE=14
BILLING_AUTOMATION_DOMAIN_DAYS_BEFORE=30
BILLING_AUTOMATION_REMINDER_DAYS_BEFORE_FIRST=7
BILLING_AUTOMATION_REMINDER_DAYS_BEFORE_DUE=0
BILLING_AUTOMATION_REMINDER_DAYS_AFTER_DUE=14

# Queue name for outbound billing emails (requires queue worker)
BILLING_MAIL_QUEUE=default

VITE_APP_NAME="${APP_NAME}"
